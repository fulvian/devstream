{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$DEVSTREAM_PROJECT_ROOT\" && ./.devstream/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/devstream/context/user_query_context_enhancer.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "cd \"$DEVSTREAM_PROJECT_ROOT\" && ./.devstream/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/devstream/protocol/task_first_handler.py",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$DEVSTREAM_PROJECT_ROOT\" && ./.devstream/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/devstream/concurrency_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$DEVSTREAM_PROJECT_ROOT\" && ./.devstream/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/devstream/memory/pre_tool_use.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$DEVSTREAM_PROJECT_ROOT\" && ./.devstream/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/devstream/memory/post_tool_use.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$DEVSTREAM_PROJECT_ROOT\" && ./.devstream/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/devstream/protocol/micro_task_commit_handler.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": []
  },
  "permissions": {
    "allow": [
      "Read(**/*)",
      "Write(**/*)",
      "Edit(**/*)",
      "Bash",
      "TodoWrite",
      "mcp__*",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "DEVSTREAM_CONCURRENCY_LIMIT": "1",
    "DEVSTREAM_TIMEOUT": "30000",
    "DEVSTREAM_RETRY_ATTEMPTS": "3",
    "DEVSTREAM_CIRCUIT_BREAKER_THRESHOLD": "5",
    "CONTEXT7_CONCURRENCY_LIMIT": "1",
    "CONTEXT7_TIMEOUT": "15000",
    "CONTEXT7_RETRY_ATTEMPTS": "2",
    "CONTEXT7_TOKEN_BUDGET": "5000",
    "DEVSTREAM_DB_PATH": "data/devstream.db",
    "DEVSTREAM_PROJECT_ROOT": ".",
    "DEVSTREAM_SESSION_TRACKING_ENABLED": "true",
    "DEVSTREAM_SESSION_CLEANUP_INTERVAL": "3600",
    "DEVSTREAM_MAX_SESSION_DURATION": "86400"
  }
}