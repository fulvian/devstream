# ==============================================
# DevStream Multi-Project Configuration Template
# Copy to .env.devstream for each project instance
# ==============================================

# ============================================================================
# CORE DEVSTREAM CONFIGURATION (MANDATORY)
# ============================================================================

# Database path - RELATIVE to project root for multi-project support
# Each project should have its own database: data/devstream.db
DEVSTREAM_DB_PATH=data/devstream.db

# Direct Database Architecture (v2.2.0+)
DEVSTREAM_DIRECT_DB_ENABLED=true
DEVSTREAM_DB_PATH=data/devstream.db

# ============================================================================
# MEMORY SYSTEM CONFIGURATION
# ============================================================================

# Semantic memory system (MANDATORY)
DEVSTREAM_MEMORY_ENABLED=true
DEVSTREAM_MEMORY_FEEDBACK_LEVEL=minimal

# Vector search configuration
DEVSTREAM_VECTOR_SEARCH_ENABLED=true
DEVSTREAM_VECTOR_EMBEDDINGS_MODEL=gemma3
DEVSTREAM_VECTOR_DB_ENABLED=true

# ============================================================================
# CONTEXT INJECTION CONFIGURATION
# ============================================================================

# Context7 integration (MANDATORY for research)
DEVSTREAM_CONTEXT7_ENABLED=true
DEVSTREAM_CONTEXT7_AUTO_DETECT=true
DEVSTREAM_CONTEXT7_TOKEN_BUDGET=5000

# DevStream memory context injection
DEVSTREAM_CONTEXT_INJECTION_ENABLED=true
DEVSTREAM_CONTEXT_MAX_TOKENS=2000
DEVSTREAM_CONTEXT_RELEVANCE_THRESHOLD=0.5

# ============================================================================
# TIER-BASED DELEGATION (v2.2.0+)
# ============================================================================

# Automatic delegation optimization
DEVSTREAM_AUTO_DELEGATION_TIER1_ENABLED=true
DEVSTREAM_AUTO_DELEGATION_TIER2_THRESHOLD=0.95
DEVSTREAM_AUTO_DELEGATION_TIER3_THRESHOLD=0.70
DEVSTREAM_AUTO_DELEGATION_QUALITY_GATE=true

# ============================================================================
# IMPLEMENTATION PLANS (v2.2.0+)
# ============================================================================

# Implementation plans with dual storage
DEVSTREAM_IMPLEMENTATION_PLANS_ENABLED=true
DEVSTREAM_DUAL_STORAGE_ENABLED=true

# ============================================================================
# SESSION MANAGEMENT (v2.2.0+)
# ============================================================================

# Session hooks (disabled to prevent Claude Code auto-compacting interference)
DEVSTREAM_HOOK_SESSIONSTART=false
DEVSTREAM_HOOK_SESSION_END=false
DEVSTREAM_HOOK_PRE_COMPACT=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Structured logging with context
DEVSTREAM_LOG_LEVEL=INFO
DEVSTREAM_LOG_PATH=~/.claude/logs/devstream/

# ============================================================================
# CONTEXT7 MCP CONFIGURATION (OPTIONAL but RECOMMENDED)
# ============================================================================

# Context7 API key for library documentation retrieval
# Get your free API key at: https://context7.com
# Used by Context7 MCP server for research-driven development
# Optional but recommended for DevStream RESEARCH phase
CONTEXT7_API_KEY=

# ============================================================================
# PROJECT-SPECIFIC CONFIGURATION
# ============================================================================

# Project identification (optional - helps with multi-project management)
DEVSTREAM_PROJECT_NAME=change-this-to-your-project-name
DEVSTREAM_PROJECT_DESCRIPTION=Brief description of your project

# Custom settings for this project instance
# CUSTOM_SETTING=value