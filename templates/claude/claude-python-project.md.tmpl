DEVSTREAM_PROJECT_VENV_PATH={{ project.venv_path }}
DEVSTREAM_PROJECT_VENV_PYTHON={{ project.python_executable }}
DEVSTREAM_PROJECT_VENV_PIP={{ project.pip_executable }}
DEVSTREAM_PROJECT_ROOT={{ project.root }}
DEVSTREAM_PROJECT_NAME={{ project.name }}

# Framework paths (for reference)
